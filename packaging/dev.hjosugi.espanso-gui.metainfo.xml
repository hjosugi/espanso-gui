<component type="desktop-application">
  <id>dev.hjosugi.espanso-gui</id>
  <name>Espanso GUI</name>
  <summary>Visual editor for Espanso text-expansion configuration</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <developer id="github.com/hjosugi">
    <name>hjosugi</name>
  </developer>
  <description>
    <p>
      Espanso GUI is an independent, unofficial visual editor for Espanso 2.
      It manages snippets, rich content, variables, forms, global variables,
      backups, imports, and exports without requiring users to hand-edit YAML.
    </p>
  </description>
  <launchable type="desktop-id">espanso-gui.desktop</launchable>
  <provides>
    <binary>espanso-gui</binary>
  </provides>
  <url type="homepage">https://github.com/hjosugi/espanso-gui</url>
  <url type="bugtracker">https://github.com/hjosugi/espanso-gui/issues</url>
  <releases>
